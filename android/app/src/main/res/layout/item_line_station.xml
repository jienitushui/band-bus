<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/stationOrder" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="#6B7280" android:textSize="13sp" />
    <FrameLayout android:layout_width="30dp" android:layout_height="match_parent">
        <View android:id="@+id/stationConnectorTop" android:layout_width="2dp" android:layout_height="30dp" android:layout_gravity="top|center_horizontal" android:background="#CBD5E1" />
        <View android:id="@+id/stationConnectorBottom" android:layout_width="2dp" android:layout_height="30dp" android:layout_gravity="bottom|center_horizontal" android:background="#CBD5E1" />
        <View android:id="@+id/stationDot" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:background="@drawable/bg_station_dot" />
        <ImageView android:id="@+id/stationBusMarker" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|center_horizontal" android:background="#F7F8FA" android:contentDescription="@null" android:padding="2dp" android:src="@drawable/ic_bus" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/stationName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="#111827" android:textSize="15sp" />
    <TextView android:id="@+id/stationStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#2563EB" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/stationVehicle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="2" android:textColor="#059669" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
