{
  "package": "uno.keyin.bus",
  "name": "腕上公交",
  "versionName": "V26.2.7.BAND",
  "versionCode": 260308,
  "minPlatformVersion": 1100,
  "icon": "/common/logo.png",
  "simulationVersion": "default",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.fetch"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.geolocation"
    },
    {
      "name": "system.app"
    },
    {
      "name": "system.interconnect"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.brightness"
    }
  ],
  "permissions": [
    {
      "name": "hapjs.permission.LOCATION"
    },
    {
      "name": "hapjs.permission.INTERNET"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 336
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index",
        "launchMode": "singleTask"
      },
      "pages/stations": {
        "component": "stations"
      },
      "pages/stationLines": {
        "component": "stationLines"
      },
      "pages/busDetail": {
        "component": "busDetail"
      },
      "pages/routeScheduleDetail": {
        "component": "routeScheduleDetail"
      },
      "pages/vehicleDetail": {
        "component": "vehicleDetail"
      },
      "pages/transferPlan": {
        "component": "transferPlan"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}
