  position: absolute;
  left: 28px;
  top: 14px;
  background-color: rgba(255,255,255,0.10);
}

.back-icon {
  width: 34px;
  height: 34px;
  object-fit: contain;
}

.title-wrap {
  position: absolute;
  left: 88px;
  top: 12px;
  width: 172px;
  height: 66px;
  flex-direction: column;
  align-items: center;
}

.title-text {
  width: 172px;
  line-height: 36px;
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.sub-title {
  width: 172px;
  line-height: 26px;
  font-size: 18px;
  font-weight: bold;
  color: rgba(255,255,255,0.62);
  text-align: center;
  text-overflow: ellipsis;
}

.nav-placeholder {
  position: absolute;
  left: 254px;
  top: 14px;
  width: 54px;
  height: 54px;
}

.content {
  position: absolute;
  left: 0px;
  top: 94px;
  width: 336px;
  height: 242px;
  padding: 12px 20px 20px 20px;
  flex-direction: column;
  align-items: center;
}

.bus-hero {
  width: 296px;
  height: 74px;
  border-radius: 22px;
  border: 2px solid rgba(251,146,60,0.28);
  background-color: rgba(251,146,60,0.12);
  flex-direction: row;
  align-items: center;
  padding: 13px 20px;
}

.bus-icon {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.bus-number {
  margin-left: 18px;
  width: 190px;
  line-height: 48px;
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
  text-overflow: ellipsis;
}

.info-list {
  margin-top: 10px;
  width: 296px;
  height: 150px;
  flex-direction: column;
}

.info-row {
  width: 296px;
  height: 28px;
  margin-bottom: 2px;
  flex-direction: row;
  align-items: center;
}

.info-label {
  width: 64px;
  line-height: 28px;
  font-size: 18px;
  font-weight: bold;
  color: rgba(255,255,255,0.50);
}

.info-value {
  width: 220px;
  line-height: 28px;
  font-size: 21px;
  font-weight: bold;
  color: #ffffff;
  text-overflow: ellipsis;
}

.edge-back-zone {
  position: absolute;
  left: 0px;
  top: 94px;
  width: 24px;
  height: 242px;
  background-color: rgba(0,0,0,0.01);
}
</style>
