<template>
  <div class="page" style="height: {{pageHeight}}px;">
    <div class="detail-nav">
      <div class="round-btn back-btn" @click="back">
        <image static src="/common/images/icon_back1.png" class="back-icon" />
      </div>
      <div class="nav-center">
        <text static class="nav-title">运营时刻</text>
        <text class="nav-route" style="lines:1;">{{routeTitle}}</text>
      </div>
      <div class="nav-placeholder"></div>
    </div>

    <div if="{{scheduleSections.length > 0}}" class="card-stage" style="height: {{contentHeight}}px;">
      <list class="bus-card-list" bounces="false" style="height: {{contentHeight}}px;">
        <list-item for="{{scheduleSections}}" type="schedule" class="bus-card-item" style="height: {{$item.cardHeight}}px;">
          <div class="bus-card-simple">
            <div class="bus-line-row schedule-line-row">
              <text class="bus-line-name" style="lines:-1;">{{$item.title}}</text>
              <text static class="bus-eta-pill schedule-eta-pill">运营</text>
            </div>
            <div class="bus-info-row schedule-info-row">
              <text class="bus-dest-text" style="lines:-1;">{{$item.body}}</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <div if="{{scheduleSections.length === 0}}" class="state-layer" style="height: {{contentHeight}}px;">
      <text static class="state-text">暂无运营时刻说明</text>
    </div>

    <div class="edge-back-zone" style="height: {{contentHeight}}px;" @swipe="onEdgeBackSwipe"></div>
  </div>
</template>

<script>
import router from '@system.router'
import device from '@system.device'

const DESIGN_WIDTH = 336
const DEFAULT_PAGE_HEIGHT = 336
const NAV_HEIGHT = 94
const CARD_PAD_Y = 32
const ROW1_LINE = 34
const ROW_GAP = 12
const BODY_LINE = 28

export default {
  protected: {
    routeTitle: '',
    payload: ''
  },
  private: {
    pageHeight: DEFAULT_PAGE_HEIGHT,
    contentHeight: DEFAULT_PAGE_HEIGHT - NAV_HEIGHT,
    scheduleSections: []
  },
  onInit() {
    this.routeTitle = String(this.routeTitle || '').trim()
    this.initLayout()
    this.parsePayload()
  },
  back() {
    router.back()
  },
  onEdgeBackSwipe(e) {
    if (e && e.direction === 'right') {
      this.back()
    }
  },
  initLayout() {
    if (!device || typeof device.getInfo !== 'function') {
      this.applyLayout(DEFAULT_PAGE_HEIGHT)
      return
    }
    device.getInfo({
      success: (info) => {
        const width = Number(info && info.screenWidth) || DESIGN_WIDTH
        const height = Number(info && info.screenHeight) || DEFAULT_PAGE_HEIGHT
        const scaledHeight = Math.floor(height * DESIGN_WIDTH / width)
        this.applyLayout(scaledHeight)
      },
      fail: () => {
        this.applyLayout(DEFAULT_PAGE_HEIGHT)
      }
    })
  },
  applyLayout(height) {
    const safeHeight = Math.max(Math.min(Number(height) || DEFAULT_PAGE_HEIGHT, 520), 300)
    this.pageHeight = safeHeight
    this.contentHeight = Math.max(safeHeight - NAV_HEIGHT, 160)
  },
  estimateTextLines(text, charsPerLine) {
    const chunks = String(text || '').split('\n')
    let n = 0
    for (let i = 0; i < chunks.length; i++) {
      const line = chunks[i]
      n += Math.max(1, Math.ceil(line.length / charsPerLine))
    }
    return Math.max(1, n)
  },

  computeCardHeight(title, body) {
    const titleLines = this.estimateTextLines(title, 7)
    const bodyLines = this.estimateTextLines(body, 11)
    const row1H = Math.max(ROW1_LINE, titleLines * ROW1_LINE)
    const row2H = ROW_GAP + bodyLines * BODY_LINE
    const buffer = 18
    return Math.max(126, CARD_PAD_Y + row1H + row2H + buffer)
  },

  parsePayload() {
    const raw = String(this.payload || '').trim()
    if (!raw) {
      this.scheduleSections = []
      return
    }
    try {
      const data = JSON.parse(decodeURIComponent(raw))
      const list = data && Array.isArray(data.sections) ? data.sections : []
      this.scheduleSections = list
        .map((item) => ({
          title: item && item.title ? String(item.title) : '',
          body: item && item.body != null ? String(item.body) : ''
        }))
        .filter((item) => item.title && item.body)
        .map((item) =>
          Object.assign({}, item, {
            cardHeight: this.computeCardHeight(item.title, item.body)
          })
        )
    } catch (e) {
      this.scheduleSections = []
    }
  }
}
</script>

